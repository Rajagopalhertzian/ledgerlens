# LedgerLens Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it's in .gitignore

# =============================================================================
# Model Provider Configuration (provider-agnostic)
# The app reads ONLY these LLM_* variables, never ANTHROPIC_* or OPENAI_*
# =============================================================================

# LLM Provider: "openai" | "anthropic" | "groq" | "nvidia" | "ollama" | "custom"
LLM_PROVIDER=openai

# Base URL for the LLM API (OpenAI-compatible endpoint)
# Examples:
#   OpenAI: https://api.openai.com/v1
#   Groq: https://api.groq.com/openai/v1
#   NVIDIA NIM: https://integrate.api.nvidia.com/v1
#   Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# API Key for the LLM provider
# IMPORTANT: Named LLM_API_KEY, not ANTHROPIC_API_KEY or OPENAI_API_KEY
LLM_API_KEY=your-api-key-here

# Model roles (use provider-specific model IDs)
# CHEAP_MODEL: For classification, routing, cheap parsing
CHEAP_MODEL=gpt-4o-mini
# STRONG_MODEL: For extraction, complex reasoning
STRONG_MODEL=gpt-4o
# JUDGE_MODEL: For evaluation (MUST differ from model being graded)
JUDGE_MODEL=gpt-4o
# VLM_MODEL: For vision-language extraction (M2+)
VLM_MODEL=gpt-4o

# =============================================================================
# Database & Cache
# =============================================================================

# PostgreSQL connection (asyncpg)
DATABASE_URL=postgresql+asyncpg://ledgerlens:ledgerlens@localhost:5432/ledgerlens

# Redis connection
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# MCP Server Authentication
# =============================================================================

# Bearer tokens for MCP servers (generate secure random strings)
ERP_MCP_AUTH_TOKEN=erp-mcp-secret-change-in-production
POLICY_MCP_AUTH_TOKEN=policy-mcp-secret-change-in-production
COMMS_MCP_AUTH_TOKEN=comms-mcp-secret-change-in-production

# =============================================================================
# Cost Control
# =============================================================================

# Maximum spend in USD for evaluation runs
MAX_SPEND_USD=10.0

# =============================================================================
# Qdrant Vector Store
# =============================================================================

QDRANT_URL=http://localhost:6333

# =============================================================================
# Logging & Observability
# =============================================================================

LOG_LEVEL=INFO

# OpenTelemetry (optional - for production observability)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=ledgerlens

# =============================================================================
# API & UI
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000

UI_HOST=0.0.0.0
UI_PORT=8501

# =============================================================================
# Security (generate secure values for production)
# =============================================================================

# Secret key for approval token signing (HMAC)
APPROVAL_TOKEN_SECRET=your-approval-token-secret-32-chars-min

# API authentication (for production deployment)
API_AUTH_ENABLED=false
API_AUTH_USERNAME=admin
API_AUTH_PASSWORD=changeme